# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
# Corpus thuc te cua nhom la tieng Anh (band descriptors + bai viet ielts.org).
# text-embedding-3-small du dung; nguoi dung van co the hoi bang tieng Viet
# (cross-lingual query) vi OpenAI embeddings duoc train da ngon ngu.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# PageIndex fallback mode: local (tu dung vectorless tree tu data/standardized,
# mac dinh, khong can API key) | api (dung SDK pageindex that, can PAGEINDEX_API_KEY)
PAGEINDEX_MODE=local

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
